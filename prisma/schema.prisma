generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per agent your Hermes stack runs. Agents self-report here
/// via POST /api/agents/state. The dashboard reads from this table.
model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt
}

/// A unit of work assigned to an agent. Agents pick up pending missions,
/// run them, and update status to "completed" or "failed".
model Mission {
  id          String    @id @default(uuid())
  agentId     String
  title       String
  description String
  status      String    @default("pending")
  priority    String    @default("medium")
  result      String?
  debriefPath String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([agentId])
  @@index([status])
}

/// Ideas your agents generate for you to review.
model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  source      String?
  status      String?  @default("pending")
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([status])
}

/// Generic key-value store for agent-specific config and scratch data.
/// Use this when you need to persist something simple without adding a model.
model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model HostHealth {
  hostname  String   @id
  cpuUsage  Float
  ramUsage  Float
  diskUsage Float
  gpuTemp   Float?
  nasConnected Boolean @default(false)
  nasAvailable Float @default(0)
  updatedAt DateTime @updatedAt
}

model GeneratedFile {
  id        String   @id @default(uuid())
  path      String   @unique
  name      String
  extension String
  size      Int
  agentId   String?
  category  String?
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([category])
}
