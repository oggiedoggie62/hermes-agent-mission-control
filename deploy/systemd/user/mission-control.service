[Unit]
Description=Mission Control production web server (Next.js :3000)
Documentation=file:///home/oggie/mission-control/MC-server-launch.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/oggie/mission-control
Environment=NODE_ENV=production
Environment=PATH=/home/oggie/mission-control/node_modules/.bin:/home/oggie/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets come from the existing project .env via systemd-exec.cjs (not inlined here).
# .env must be owned by the service user and mode 0600.
ExecStartPre=/home/oggie/mission-control/scripts/wait-for-postgres.sh
ExecStart=/usr/bin/node /home/oggie/mission-control/scripts/systemd-exec.cjs /home/oggie/mission-control/node_modules/.bin/next start -p 3000
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=control-group
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mission-control

[Install]
WantedBy=default.target
